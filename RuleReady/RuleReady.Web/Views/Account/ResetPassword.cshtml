@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Choose a new password";
}
<div class="auth-card">
    <h1>Choose a new password</h1>
    <form method="post">
        @Html.AntiForgeryToken()
        <input asp-for="Email" type="hidden" />
        <input asp-for="Token" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="validation"></div>
        <label>New password<input asp-for="Password" type="password" /></label>
        <label>Confirm password<input asp-for="ConfirmPassword" type="password" /></label>
        <button class="button primary wide" type="submit">Change password</button>
    </form>
</div>
