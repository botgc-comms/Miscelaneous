@{
    ViewData["Title"] = "Pricing";
}
<div class="page-heading">
    <div class="eyebrow">RULEREADY PLANS</div>
    <h1>One learning platform. Different ways to provide access.</h1>
    <p>The final feature and price matrix is intentionally configurable while the commercial packages are being validated.</p>
</div>
<div class="grid four">
    <div class="pricing-card">
        <h2>Individual</h2>
        <p class="price">Personal</p>
        <ul>
            <li>Personal Rules learning</li>
            <li>Quiz history and progress</li>
            <li>Self-directed challenges</li>
            <li>Club associations</li>
        </ul>
        <a class="button primary" href="/account/register?intent=player">Create account</a>
    </div>
    <div class="pricing-card featured">
        <span class="badge">Core club offer</span>
        <h2>Club</h2>
        <p class="price">Annual licence</p>
        <ul>
            <li>Member access</li>
            <li>Issued quizzes and campaigns</li>
            <li>Timed assessment modes</li>
            <li>Aggregate reporting</li>
        </ul>
        <a class="button primary" href="/account/register?intent=club">Set up a club</a>
    </div>
    <div class="pricing-card">
        <h2>Enterprise</h2>
        <p class="price">Contract</p>
        <ul>
            <li>Multi-club programmes</li>
            <li>Governing body access</li>
            <li>Sponsored programmes</li>
            <li>Enterprise licensing</li>
        </ul>
        <a class="button secondary" href="/account/register?intent=organisation">Start setup</a>
    </div>
    <div class="pricing-card">
        <h2>Platform</h2>
        <p class="price">API licence</p>
        <ul>
            <li>Quiz delivery API</li>
            <li>Embedded learning</li>
            <li>Partner authentication</li>
            <li>Content licensing</li>
        </ul>
        <a class="button secondary" href="/account/register?intent=platform">Start integration</a>
    </div>
</div>
