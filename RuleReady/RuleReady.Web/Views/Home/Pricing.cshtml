@{
    ViewData["Title"] = "Pricing";
}
<div class="page-heading pricing-heading">
    <div class="eyebrow">RULEREADY PLANS</div>
    <h1>Simple ways to bring RuleReady to players, clubs and golf organisations.</h1>
    <p>Start with a personal subscription, license RuleReady for a club, or roll it out across a wider programme. Billed annually unless stated otherwise.</p>
</div>
<div class="grid four pricing-grid">
    <div class="pricing-card">
        <h2>Player or parent</h2>
        <p class="price">£4.99 <span>per month</span></p>
        <p class="price-note">or £49 per year</p>
        <ul>
            <li>Personal Rules learning library</li>
            <li>Own-time, timed and countdown quizzes</li>
            <li>Quiz history and progress tracking</li>
            <li>Optional links to one or more clubs</li>
        </ul>
        <a class="button primary" href="/account/register?intent=player">Create account</a>
    </div>
    <div class="pricing-card featured">
        <span class="pricing-sash">Most popular</span>
        <h2>Club or academy</h2>
        <p class="price">from £299 <span>per year</span></p>
        <p class="price-note">Ideal for a single club or coaching programme</p>
        <ul>
            <li>Everything in Player or parent</li>
            <li>Issue quizzes and challenges to members</li>
            <li>Access codes and campaign management</li>
            <li>Aggregate club reporting</li>
        </ul>
        <a class="button primary" href="/account/register?intent=club">Set up a club</a>
    </div>
    <div class="pricing-card">
        <h2>Organisation</h2>
        <p class="price">from £2,500 <span>per year</span></p>
        <p class="price-note">For counties, pathways, sponsorships and governing bodies</p>
        <ul>
            <li>Multi-club or multi-programme rollout</li>
            <li>Central organisation reporting</li>
            <li>Programme branding and managed access</li>
            <li>Implementation support for pilots and launches</li>
        </ul>
        <a class="button secondary" href="/account/register?intent=organisation">Talk to us</a>
    </div>
    <div class="pricing-card">
        <h2>Platform integration</h2>
        <p class="price">from £6,000 <span>per year</span></p>
        <p class="price-note">For API access, embedded learning and content licensing</p>
        <ul>
            <li>Quiz delivery API</li>
            <li>Partner authentication and entitlements</li>
            <li>Results returned into your own product</li>
            <li>Commercial platform and white-label options</li>
        </ul>
        <a class="button secondary" href="/account/register?intent=platform">Start integration</a>
    </div>
</div>
<div class="home-trust-strip pricing-strip">
    <span class="home-trust-icon" aria-hidden="true">i</span>
    <span>Need a pilot, county-wide rollout or a sponsor-funded programme? We can shape a bespoke commercial package around the same product.</span>
</div>
