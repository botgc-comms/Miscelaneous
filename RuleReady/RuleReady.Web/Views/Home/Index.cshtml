@{
    ViewData["Title"] = "Learn the Rules. Play with confidence.";
}
<section class="hero">
    <div>
        <div class="eyebrow">RULES OF GOLF · MADE CLEAR</div>
        <h1>Know what to do when it matters.</h1>
        <p>RuleReady turns the Rules of Golf into clear, visual learning and assessments designed for golfers, clubs and organisations.</p>
        <div class="actions">
            <a class="button primary" href="/account/register">Get RuleReady</a>
            <a class="button secondary" href="/pricing">See how it works</a>
        </div>
    </div>
    <div class="hero-card">
        <span class="badge">Junior friendly</span>
        <h2>Your ball drops into the hole, then bounces back out. What now?</h2>
        <div class="choice">A. Count it as holed</div>
        <div class="choice correct">B. Play it from where it stopped</div>
        <div class="choice">C. Add a penalty</div>
    </div>
</section>

<section class="section">
    <h2>How would you like to use RuleReady?</h2>
    <div class="grid four">
        <a class="product-card" href="/account/register?intent=player">
            <span class="icon">⛳</span>
            <h3>Player or parent</h3>
            <p>Learn in your own time, challenge yourself and keep your progress.</p>
        </a>
        <a class="product-card" href="/account/register?intent=club">
            <span class="icon">🏌️</span>
            <h3>Club or academy</h3>
            <p>Issue quizzes, choose assessment formats and understand how your golfers are learning.</p>
        </a>
        <a class="product-card" href="/account/register?intent=organisation">
            <span class="icon">🏛️</span>
            <h3>Organisation</h3>
            <p>Provide RuleReady across clubs, programmes, counties or national pathways.</p>
        </a>
        <a class="product-card" href="/account/register?intent=platform">
            <span class="icon">🔌</span>
            <h3>Platform integration</h3>
            <p>Deliver RuleReady quizzes and results inside an existing golf product through the API.</p>
        </a>
    </div>
</section>

<section class="section soft">
    <div class="grid three">
        <div>
            <div class="eyebrow">LEARN</div>
            <h3>In your own time</h3>
            <p>Start, stop and return whenever you want. Ideal for regular learning and practice.</p>
        </div>
        <div>
            <div class="eyebrow">ASSESS</div>
            <h3>Single sitting</h3>
            <p>A fixed overall time creates a more formal assessment experience.</p>
        </div>
        <div>
            <div class="eyebrow">CHALLENGE</div>
            <h3>Question countdown</h3>
            <p>Answer under pressure with an individual countdown for every question.</p>
        </div>
    </div>
</section>
