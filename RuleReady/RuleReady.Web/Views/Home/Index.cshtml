@{
    ViewData["Title"] = "Know the rules. Play with confidence.";
}

<div class="home-page">
    <section class="home-hero">
        <div class="home-hero__landscape" aria-hidden="true"></div>

        <div class="home-hero__copy">
            <div class="eyebrow">RULES OF GOLF · MADE CLEAR</div>
            <h1>Know the rules.<br />Play with confidence.</h1>
            <p>
                Illustrated quizzes and assessments that make the Rules of Golf stick —
                for every player, every time.
            </p>

            <div class="actions">
                <a class="button primary home-cta" href="/account/register">
                    Explore RuleReady <span aria-hidden="true">→</span>
                </a>
                <a class="button secondary home-cta" href="#ways-to-use">
                    See how it works <span class="play-icon" aria-hidden="true">▶</span>
                </a>
            </div>
        </div>

        <div class="home-hero__visual" aria-label="RuleReady quiz example and illustrated Rules scenarios">
            <div class="scenario-stack" data-scenario-carousel aria-hidden="true">
                <figure class="scenario-card" data-scenario-card>
                    <img src="/images/scenarios/ball-at-rest.png" alt="" />
                    <figcaption>Ball at rest</figcaption>
                </figure>
                <figure class="scenario-card" data-scenario-card>
                    <img src="/images/scenarios/outside-agency.png" alt="" />
                    <figcaption>Outside agency</figcaption>
                </figure>
                <figure class="scenario-card" data-scenario-card>
                    <img src="/images/scenarios/loose-impediments.png" alt="" />
                    <figcaption>Loose impediments</figcaption>
                </figure>
                <figure class="scenario-card" data-scenario-card>
                    <img src="/images/scenarios/putting.png" alt="" />
                    <figcaption>Putting</figcaption>
                </figure>
                <figure class="scenario-card" data-scenario-card>
                    <img src="/images/scenarios/ball-in-motion.png" alt="" />
                    <figcaption>Ball in motion</figcaption>
                </figure>
            </div>

            <article class="hero-quiz-card">
                <span class="badge hero-quiz-card__badge">
                    <span aria-hidden="true">☺</span>
                    Junior friendly
                </span>

                <h2>Your ball drops into the hole, then bounces back out. What now?</h2>

                <div class="hero-answer">A. Count it as holed</div>
                <div class="hero-answer hero-answer--correct">
                    <span>B. Play it from where it stopped</span>
                    <span class="answer-tick" aria-hidden="true">✓</span>
                </div>
                <div class="hero-answer">C. Add a penalty</div>

                <div class="hero-progress">
                    <span>Question 3 of 10</span>
                    <span class="hero-progress__bar"><i></i></span>
                </div>
            </article>

            <div class="scenario-note" aria-hidden="true">
                <strong>Illustrated Rules scenarios</strong>
                <span>→</span>
            </div>
        </div>
    </section>

    <section class="home-audiences" id="ways-to-use">
        <h2>How would you like to use RuleReady?</h2>

        <div class="home-audience-grid">
            <a class="home-audience-card" href="/account/register?intent=player">
                <span class="home-audience-icon" aria-hidden="true">⛳</span>
                <div>
                    <h3>Player or parent</h3>
                    <p>Learn in your own time, challenge yourself and keep your progress.</p>
                </div>
                <span class="home-audience-link">Start learning <b aria-hidden="true">→</b></span>
            </a>

            <a class="home-audience-card" href="/account/register?intent=club">
                <span class="home-audience-icon" aria-hidden="true">🏌️</span>
                <div>
                    <h3>Club or academy</h3>
                    <p>Issue quizzes, choose assessment formats and understand how your golfers are learning.</p>
                </div>
                <span class="home-audience-link">Learn more <b aria-hidden="true">→</b></span>
            </a>

            <a class="home-audience-card" href="/account/register?intent=organisation">
                <span class="home-audience-icon" aria-hidden="true">🏛️</span>
                <div>
                    <h3>Organisation</h3>
                    <p>Provide RuleReady across clubs, programmes, counties or national pathways.</p>
                </div>
                <span class="home-audience-link">Learn more <b aria-hidden="true">→</b></span>
            </a>

            <a class="home-audience-card" href="/account/register?intent=platform">
                <span class="home-audience-icon" aria-hidden="true">🔌</span>
                <div>
                    <h3>Platform integration</h3>
                    <p>Deliver RuleReady quizzes and results inside an existing golf product through the API.</p>
                </div>
                <span class="home-audience-link">Developer access <b aria-hidden="true">→</b></span>
            </a>
        </div>
    </section>

    <div class="home-trust-strip">
        <span class="home-trust-icon" aria-hidden="true">✓</span>
        <span>Built for golfers, clubs, academies and golf organisations.</span>
    </div>
</div>
