<!doctype html>
<html lang="en-GB">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - RuleReady</title>
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body>
<header class="topbar">
    <a class="brand" href="/">RuleReady<span>.golf</span></a>
    <nav>
        <a href="/pricing">Pricing</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a href="/dashboard">Dashboard</a>
            <a href="/quiz/new">Challenge yourself</a>
            <a href="/quiz/join">Enter quiz code</a>
            <form method="post" action="/account/logout" class="inline-form">
                @Html.AntiForgeryToken()
                <button class="link-button" type="submit">Sign out</button>
            </form>
        }
        else
        {
            <a href="/account/login">Sign in</a>
            <a class="nav-cta" href="/account/register">Get RuleReady</a>
        }
    </nav>
</header>
<main class="shell">
    @RenderBody()
</main>
<footer class="footer">
    <strong>RuleReady</strong>
    <span>Rules education for better golf.</span>
</footer>
<script>
document.querySelectorAll("[data-countdown]").forEach(function (element) {
    let remaining = Number(element.dataset.countdown);
    const form = document.getElementById(element.dataset.form);
    const render = function () {
        element.textContent = remaining + "s";
        if (remaining <= 0) {
            const inputs = form.querySelectorAll("input[type=checkbox],input[type=radio]");
            inputs.forEach(function (input) { input.checked = false; });
            form.submit();
            return;
        }
        remaining -= 1;
        window.setTimeout(render, 1000);
    };
    render();
});


(function () {
    const carousel = document.querySelector("[data-scenario-carousel]");
    if (!carousel) {
        return;
    }

    const cards = Array.from(carousel.querySelectorAll("[data-scenario-card]"));
    const classes = ["is-up-2", "is-up-1", "is-centre", "is-down-1", "is-down-2", "is-hidden"];
    let currentIndex = 0;
    let timer = null;
    let isPaused = false;

    function updateCarousel() {
        cards.forEach(function (card, index) {
            classes.forEach(function (className) {
                card.classList.remove(className);
            });

            const offset = (index - currentIndex + cards.length) % cards.length;

            if (offset === 0) {
                card.classList.add("is-centre");
            } else if (offset === 1) {
                card.classList.add("is-down-1");
            } else if (offset === 2) {
                card.classList.add("is-down-2");
            } else if (offset === cards.length - 1) {
                card.classList.add("is-up-1");
            } else if (offset === cards.length - 2) {
                card.classList.add("is-up-2");
            } else {
                card.classList.add("is-hidden");
            }
        });
    }

    function next() {
        currentIndex = (currentIndex + 1) % cards.length;
        updateCarousel();
    }

    function start() {
        if (timer !== null || isPaused) {
            return;
        }
        timer = window.setInterval(next, 4000);
    }

    function stop() {
        if (timer !== null) {
            window.clearInterval(timer);
            timer = null;
        }
    }

    cards.forEach(function (card, index) {
        card.addEventListener("click", function () {
            currentIndex = index;
            updateCarousel();
            stop();
            start();
        });
    });

    carousel.addEventListener("mouseenter", function () {
        isPaused = true;
        stop();
    });

    carousel.addEventListener("mouseleave", function () {
        isPaused = false;
        start();
    });

    document.addEventListener("visibilitychange", function () {
        if (document.hidden) {
            stop();
        } else if (!isPaused) {
            start();
        }
    });

    updateCarousel();
    start();
})();
</script>
</body>
</html>
