# Required for automatic engraving reading and generated trophy illustrations.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=high

# Optional. Use {{trophy_name}} where the trophy name should be inserted.
# Leave empty to use the built-in straight-on, shelf-ready vector illustration prompt.
TROPHY_ILLUSTRATION_PROMPT=

# Wait after the most recent upload before analysing the whole image set (2-60 seconds).
ANALYSIS_DEBOUNCE_SECONDS=20

# Local default is ./data-store. Render sets this to its persistent disk.
# Account records, protected session keys, club logos, catalogues and images live here.
DATA_PATH=
