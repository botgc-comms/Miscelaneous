diff --git a/wwwroot/marketing.css b/wwwroot/marketing.css
--- a/wwwroot/marketing.css
+++ b/wwwroot/marketing.css
@@ -32,0 +33,1 @@
+
+/* Homepage art direction: museum-grade sporting archive. Scoped so regional guides retain their own header layout. */
+.marketing-home .site-header {
+  position: absolute;
+  inset: 0 0 auto;
+  width: 100%;
+  border-bottom-color: rgba(224, 200, 131, .18);
+  background: linear-gradient(180deg, rgba(2, 17, 13, .84), rgba(2, 17, 13, .62));
+  -webkit-backdrop-filter: blur(18px) saturate(1.08);
+  backdrop-filter: blur(18px) saturate(1.08);
+}
+.marketing-home .header-inner {
+  width: min(1480px, calc(100% - 48px));
+  min-height: 78px;
+}
+.marketing-home .main-nav { gap: clamp(24px, 2.4vw, 40px); }
+.marketing-home .main-nav a { font-size: 14px; }
+.marketing-home .login-link,
+.marketing-home .signup-link,
+.marketing-home .archive-link { min-height: 46px; border-radius: 8px; }
+.marketing-home .login-link { background: rgba(2, 17, 13, .22); }
+.marketing-home .signup-link,
+.marketing-home .archive-link { background: rgba(9, 78, 59, .86); }
+
+.marketing-home .hero { min-height: 820px; }
+.marketing-home .hero::before {
+  background-position: right center;
+  transform: scale(1.14);
+  transform-origin: 78% 48%;
+}
+.marketing-home .hero::after {
+  background:
+    linear-gradient(90deg, rgba(2, 17, 13, .99) 0%, rgba(2, 17, 13, .95) 28%, rgba(2, 17, 13, .58) 49%, rgba(2, 17, 13, .20) 72%, rgba(2, 17, 13, .62) 100%),
+    linear-gradient(0deg, rgba(1, 12, 9, .76), transparent 46%);
+}
+.marketing-home .hero-inner {
+  width: min(1480px, calc(100% - 64px));
+  min-height: 820px;
+  padding: 130px 0 76px;
+  grid-template-columns: minmax(0, 630px) minmax(470px, 1fr);
+  gap: clamp(42px, 5vw, 82px);
+}
+.marketing-home .hero-copy { max-width: 630px; }
+.marketing-home .hero .eyebrow { margin-bottom: 20px; font-size: 11px; }
+.marketing-home .hero h1 {
+  font-size: clamp(64px, 5.4vw, 88px);
+  line-height: .89;
+  letter-spacing: -.049em;
+}
+.marketing-home .hero h1 > span { display: block; white-space: nowrap; }
+.marketing-home .hero h1 em { font-style: italic; }
+.marketing-home .hero-intro {
+  max-width: 520px;
+  margin-top: 30px;
+  color: #dbe1dc;
+  font-size: 16px;
+  line-height: 1.68;
+}
+.marketing-home .hero-actions { margin-top: 32px; gap: 12px; }
+.marketing-home .primary-button,
+.marketing-home .secondary-button {
+  min-height: 54px;
+  border-radius: 4px;
+  font-size: 13px;
+  letter-spacing: .01em;
+  transition: transform .18s ease, background-color .18s ease, border-color .18s ease;
+}
+.marketing-home .primary-button { justify-content: space-between; gap: 22px; }
+.marketing-home .primary-button > span { font-size: 17px; line-height: 1; }
+.marketing-home .secondary-button { gap: 10px; background: rgba(2, 18, 13, .24); }
+.marketing-home .button-play {
+  width: 24px;
+  height: 24px;
+  display: grid;
+  place-items: center;
+  border: 1px solid rgba(255, 255, 255, .52);
+  border-radius: 50%;
+  font-size: 12px;
+}
+.marketing-home .primary-button:hover,
+.marketing-home .secondary-button:hover { transform: translateY(-2px); }
+.marketing-home .hero-points {
+  margin-top: 34px;
+  padding-top: 24px;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 24px;
+}
+.marketing-home .hero-points li { gap: 11px; align-items: flex-start; }
+.marketing-home .point-mark {
+  width: 34px;
+  height: 34px;
+  border: 0;
+  border-radius: 0;
+  color: #ddb95f;
+}
+.marketing-home .point-mark svg {
+  width: 30px;
+  height: 30px;
+  fill: none;
+  stroke: currentColor;
+  stroke-width: 1.45;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+}
+.marketing-home .hero-points li > span:last-child { gap: 3px; }
+.marketing-home .hero-points strong { font-size: 13px; line-height: 1.28; }
+.marketing-home .hero-points small { color: #b8c4be; font-size: 10px; line-height: 1.42; }
+
+.marketing-home .product-preview {
+  width: min(100%, 580px);
+  padding: 14px;
+  border-color: rgba(220, 185, 95, .46);
+  border-radius: 20px;
+  background: linear-gradient(145deg, rgba(6, 66, 50, .95), rgba(3, 48, 37, .91));
+  box-shadow: 0 36px 100px rgba(0, 0, 0, .5);
+  transform: rotate(-.35deg);
+}
+.marketing-home .preview-topbar { min-height: 66px; }
+.marketing-home .preview-topbar > em {
+  margin-left: auto;
+  padding: 5px 8px;
+  border: 1px solid rgba(231, 207, 139, .35);
+  border-radius: 999px;
+  color: #e6ce89;
+  font-size: 8px;
+  font-style: normal;
+  font-weight: 700;
+  letter-spacing: .08em;
+  text-transform: uppercase;
+}
+.marketing-home .preview-stage > img { transform: scale(1.1); }
+.marketing-home .product-preview figcaption { min-height: 66px; }
+
+.marketing-home .club-strip {
+  min-height: 158px;
+  padding: 27px max(32px, calc((100% - 1420px) / 2));
+  gap: 24px;
+  background: linear-gradient(180deg, #faf8f2, #f2eee5);
+}
+.marketing-home .club-strip p { color: #8b7244; font-size: 10px; }
+.marketing-home .club-strip ul {
+  display: grid;
+  grid-template-columns: repeat(6, minmax(0, 1fr));
+  gap: 0;
+}
+.marketing-home .club-strip li {
+  min-height: 52px;
+  padding: 0 18px;
+  justify-content: center;
+  gap: 13px;
+  color: #48534e;
+}
+.marketing-home .club-strip li + li { border-left: 1px solid #d5d0c4; }
+.marketing-home .club-strip li > .club-icon {
+  width: 42px;
+  height: 42px;
+  border: 0;
+  border-radius: 0;
+  color: #64716b;
+}
+.marketing-home .club-icon svg {
+  width: 40px;
+  height: 40px;
+  fill: none;
+  stroke: currentColor;
+  stroke-width: 1.45;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+}
+.marketing-home .club-strip strong { max-width: 120px; font-size: 11px; line-height: 1.35; }
+
+.marketing-home .workflow-band {
+  position: relative;
+  overflow: hidden;
+  background:
+    radial-gradient(circle at 52% 12%, rgba(21, 88, 68, .30), transparent 32%),
+    linear-gradient(112deg, #06291f, #031d17 62%, #06251d);
+}
+.marketing-home .workflow-band::before {
+  position: absolute;
+  inset: 0;
+  pointer-events: none;
+  background: repeating-linear-gradient(112deg, transparent 0 74px, rgba(221, 185, 95, .025) 75px 76px);
+  content: "";
+}
+.marketing-home .workflow-inner {
+  position: relative;
+  width: min(1500px, calc(100% - 48px));
+  padding: 88px 0 96px;
+  grid-template-columns: 335px minmax(0, 1fr);
+  gap: 44px;
+}
+.marketing-home .workflow-lead { padding-top: 6px; }
+.marketing-home .workflow-lead h2 { font-size: 46px; line-height: 1.01; }
+.marketing-home .workflow-lead > p:not(.eyebrow) {
+  margin-top: 25px;
+  color: #c3d0ca;
+  font-size: 14px;
+  line-height: 1.72;
+}
+.marketing-home .workflow-link {
+  margin-top: 28px;
+  display: inline-flex;
+  align-items: center;
+  gap: 10px;
+  color: #f0d792;
+  font-size: 13px;
+  text-underline-offset: 5px;
+}
+.marketing-home .workflow-link span { font-size: 17px; }
+.marketing-home .workflow-steps { gap: 16px; }
+.marketing-home .workflow-steps > li {
+  position: relative;
+  min-height: 560px;
+  padding: 23px 20px 0;
+  overflow: visible;
+  border-color: rgba(213, 176, 89, .30);
+  border-radius: 9px;
+  background: linear-gradient(180deg, rgba(2, 31, 24, .76), rgba(1, 22, 17, .68));
+  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .025), 0 22px 48px rgba(0, 0, 0, .13);
+}
+.marketing-home .workflow-steps > li:not(:last-child)::after {
+  position: absolute;
+  z-index: 3;
+  top: 52%;
+  right: -25px;
+  width: 32px;
+  color: #d9b65f;
+  content: "→";
+  font-family: var(--serif);
+  font-size: 27px;
+  line-height: 1;
+  text-align: center;
+}
+.marketing-home .step-number {
+  width: 31px;
+  height: 31px;
+  border-color: #a98232;
+  background: rgba(211, 173, 88, .06);
+  font-size: 9px;
+}
+.marketing-home .workflow-steps h3 { margin-top: 16px; font-size: 27px; }
+.marketing-home .workflow-steps p {
+  min-height: 126px;
+  color: #c1cec8;
+  font-size: 13px;
+  line-height: 1.58;
+}
+.marketing-home .step-visual {
+  min-height: 286px;
+  margin: auto -20px 0;
+  overflow: hidden;
+  border-radius: 0 0 8px 8px;
+  border-top-color: rgba(210, 173, 88, .24);
+}
+.marketing-home .phone-visual,
+.marketing-home .scan-visual,
+.marketing-home .export-visual { position: relative; display: block; }
+.marketing-home .phone-visual::after,
+.marketing-home .scan-visual::before,
+.marketing-home .export-visual::before {
+  position: absolute;
+  inset: 0;
+  pointer-events: none;
+  content: "";
+}
+.marketing-home .phone-visual::after { background: linear-gradient(0deg, rgba(2, 19, 14, .35), transparent 45%); }
+.marketing-home .phone-visual img,
+.marketing-home .scan-visual img,
+.marketing-home .export-visual img {
+  width: 100%;
+  height: 100%;
+  display: block;
+  object-fit: cover;
+}
+.marketing-home .phone-visual img { object-position: 50% 46%; filter: saturate(.85) contrast(1.08); }
+.marketing-home .scan-visual img { object-position: 52% center; filter: saturate(.76) brightness(.77) contrast(1.12); transform: scale(1.04); }
+.marketing-home .scan-visual::before { z-index: 1; background: linear-gradient(180deg, rgba(2, 20, 15, .06), rgba(2, 20, 15, .38)); }
+.marketing-home .scan-visual::after {
+  z-index: 2;
+  inset: 54% 12px auto;
+  height: 2px;
+  background: #deb95e;
+  box-shadow: 0 0 16px 3px rgba(222, 185, 94, .28);
+}
+.marketing-home .scan-visual > span,
+.marketing-home .export-visual > span {
+  position: absolute;
+  z-index: 3;
+  left: 14px;
+  bottom: 14px;
+  padding: 7px 9px;
+  border: 1px solid rgba(223, 191, 111, .28);
+  border-radius: 4px;
+  background: rgba(2, 22, 17, .82);
+  color: #ead396;
+  font-size: 9px;
+  font-weight: 700;
+  letter-spacing: .07em;
+  text-transform: uppercase;
+}
+.marketing-home .review-visual {
+  padding: 28px 15px;
+  align-content: center;
+  gap: 10px;
+  background: radial-gradient(circle at 50% 35%, #0d3c2f, #041c16 72%);
+}
+.marketing-home .review-visual > span {
+  min-height: 62px;
+  padding: 10px 10px 10px 11px;
+  grid-template-columns: 42px minmax(0, 1fr) 27px;
+  grid-template-rows: auto auto;
+  align-items: center;
+  column-gap: 8px;
+  border-color: #346755;
+  border-radius: 7px;
+  background: rgba(10, 48, 37, .92);
+}
+.marketing-home .review-visual small { grid-column: 1; grid-row: 1 / 3; font-size: 10px; }
+.marketing-home .review-visual b { grid-column: 2; grid-row: 1; font-size: 11px; line-height: 1.25; }
+.marketing-home .review-visual em { grid-column: 2; grid-row: 2; font-size: 8px; letter-spacing: .04em; text-transform: uppercase; }
+.marketing-home .review-visual i {
+  width: 24px;
+  height: 24px;
+  grid-column: 3;
+  grid-row: 1 / 3;
+  display: grid;
+  place-items: center;
+  border: 1px solid rgba(113, 207, 169, .42);
+  border-radius: 50%;
+  color: #8ad8b8;
+  font-size: 10px;
+  font-style: normal;
+}
+.marketing-home .review-visual .is-uncertain { opacity: 1; border-color: rgba(216, 179, 91, .72); }
+.marketing-home .review-visual .is-uncertain em,
+.marketing-home .review-visual .is-uncertain i { color: #e0bd68; }
+.marketing-home .review-visual .is-uncertain i { border-color: rgba(224, 189, 104, .52); }
+.marketing-home .export-visual img { object-position: 52% center; filter: saturate(.78) brightness(.73) contrast(1.12); transform: scale(1.08); }
+.marketing-home .export-visual::before { z-index: 1; background: linear-gradient(180deg, rgba(1, 17, 13, .03), rgba(1, 17, 13, .50)); }
+
+@media (max-width: 1320px) {
+  .marketing-home .hero-inner { grid-template-columns: minmax(0, 570px) minmax(440px, 1fr); gap: 38px; }
+  .marketing-home .hero h1 { font-size: clamp(60px, 5.2vw, 76px); }
+  .marketing-home .workflow-inner { grid-template-columns: 290px minmax(0, 1fr); gap: 28px; }
+  .marketing-home .workflow-lead h2 { font-size: 41px; }
+  .marketing-home .workflow-steps { gap: 12px; }
+  .marketing-home .workflow-steps > li { min-height: 530px; padding-inline: 16px; }
+  .marketing-home .workflow-steps p { min-height: 126px; font-size: 12px; }
+  .marketing-home .step-visual { min-height: 270px; margin-inline: -16px; }
+  .marketing-home .workflow-steps > li:not(:last-child)::after { right: -20px; }
+}
+
+@media (max-width: 1180px) {
+  .marketing-home .header-inner,
+  .marketing-home .hero-inner,
+  .marketing-home .workflow-inner { width: min(100% - 40px, 1180px); }
+  .marketing-home .hero-inner { grid-template-columns: minmax(0, 1fr) minmax(420px, .9fr); }
+  .marketing-home .hero h1 { font-size: clamp(56px, 6.1vw, 72px); }
+  .marketing-home .club-strip ul { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 22px; }
+  .marketing-home .club-strip li:nth-child(4) { border-left: 0; }
+  .marketing-home .workflow-inner { grid-template-columns: 1fr; gap: 40px; }
+  .marketing-home .workflow-lead { max-width: 720px; }
+  .marketing-home .workflow-lead h2 { font-size: 46px; }
+  .marketing-home .workflow-steps { grid-template-columns: 1fr 1fr; gap: 18px; }
+  .marketing-home .workflow-steps > li { min-height: 540px; padding-inline: 22px; }
+  .marketing-home .workflow-steps > li::after { display: none; }
+  .marketing-home .workflow-steps p { min-height: 104px; font-size: 14px; }
+  .marketing-home .step-visual { min-height: 300px; margin-inline: -22px; }
+}
+
+@media (max-width: 820px) {
+  .marketing-home .header-inner { width: min(100% - 24px, 760px); min-height: 70px; }
+  .marketing-home .hero::before { background-position: 64% center; transform: scale(1.08); }
+  .marketing-home .hero::after { background: linear-gradient(180deg, rgba(2, 17, 13, .84), rgba(2, 17, 13, .64) 44%, rgba(2, 17, 13, .98) 87%); }
+  .marketing-home .hero-inner {
+    width: min(100% - 40px, 700px);
+    padding: 112px 0 72px;
+    grid-template-columns: 1fr;
+    gap: 54px;
+  }
+  .marketing-home .hero-copy { max-width: 650px; }
+  .marketing-home .hero h1 { font-size: clamp(58px, 11.2vw, 78px); }
+  .marketing-home .product-preview { margin-inline: auto; }
+  .marketing-home .club-strip { padding-inline: 22px; }
+  .marketing-home .club-strip li { padding-inline: 12px; }
+  .marketing-home .workflow-inner { padding: 70px 0 78px; }
+}
+
+@media (max-width: 620px) {
+  .marketing-home .hero-inner { width: min(100% - 28px, 560px); }
+  .marketing-home .hero h1 { font-size: clamp(48px, 14vw, 60px); line-height: .91; }
+  .marketing-home .hero-intro { font-size: 15px; }
+  .marketing-home .hero-actions { grid-template-columns: 1fr; }
+  .marketing-home .hero-points { grid-template-columns: 1fr; gap: 15px; }
+  .marketing-home .hero-points li { max-width: 340px; }
+  .marketing-home .preview-topbar > em { display: none; }
+  .marketing-home .club-strip { min-height: 0; padding-block: 30px; }
+  .marketing-home .club-strip ul { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 22px; }
+  .marketing-home .club-strip li { min-width: 0; padding-inline: 8px; justify-content: flex-start; }
+  .marketing-home .club-strip li + li { border-left: 0; }
+  .marketing-home .club-strip li:nth-child(even) { border-left: 1px solid #d5d0c4; }
+  .marketing-home .club-strip li > .club-icon { width: 35px; height: 35px; }
+  .marketing-home .club-icon svg { width: 34px; height: 34px; }
+  .marketing-home .club-strip strong { font-size: 10px; }
+  .marketing-home .workflow-inner { width: min(100% - 28px, 560px); }
+  .marketing-home .workflow-lead h2 { font-size: 39px; }
+  .marketing-home .workflow-steps { grid-template-columns: 1fr; }
+  .marketing-home .workflow-steps > li { min-height: 535px; }
+  .marketing-home .workflow-steps p { min-height: 86px; }
+}
+
+@media (max-width: 380px) {
+  .marketing-home .hero h1 { font-size: 46px; }
+  .marketing-home .hero h1 > span { white-space: normal; }
+  .marketing-home .club-strip li { display: grid; grid-template-columns: 34px 1fr; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  html { scroll-behavior: auto; }
+  .marketing-home .primary-button,
+  .marketing-home .secondary-button { transition: none; }
+  .marketing-home .primary-button:hover,
+  .marketing-home .secondary-button:hover { transform: none; }
+}
