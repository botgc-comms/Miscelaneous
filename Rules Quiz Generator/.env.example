# Required in production. Locally, omit PORTAL_PASSWORD to disable authentication.
PORTAL_USERNAME=admin
PORTAL_PASSWORD=replace-with-a-long-random-password
OPENAI_API_KEY=replace-with-your-openai-api-key

# GitHub publication target. Use a fine-grained token limited to this repository
# with Contents and Pull requests read/write permissions.
RULESREADY_GITHUB_REPOSITORY=owner/rulesready
RULESREADY_GITHUB_TOKEN=replace-with-a-fine-grained-github-token
RULESREADY_GITHUB_BRANCH=main
RULESREADY_CONTENT_PATH=public/content/rules
RULESREADY_LIVE_MANIFEST_URL=https://rulesready.golf/content/rules/library.json

# Render sets PORT automatically.
PORT=4317

# On Render this is the persistent disk mount.
# DATA_ROOT=/var/data

# Optional model overrides.
OPENAI_QUESTION_MODEL=gpt-4.1
OPENAI_JUNIOR_TEXT_MODEL=gpt-4.1
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=high
