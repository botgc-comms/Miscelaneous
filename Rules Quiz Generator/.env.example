# Required in production. Locally, omit PORTAL_PASSWORD to disable authentication.
PORTAL_USERNAME=admin
PORTAL_PASSWORD=replace-with-a-long-random-password
OPENAI_API_KEY=replace-with-your-openai-api-key

# Render sets PORT automatically.
PORT=4317

# On Render this is the persistent disk mount.
# DATA_ROOT=/var/data

# Optional model overrides.
OPENAI_QUESTION_MODEL=gpt-4.1
OPENAI_JUNIOR_TEXT_MODEL=gpt-4.1
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=high
