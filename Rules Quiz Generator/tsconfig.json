{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "noImplicitOverride": true,
    "noEmitOnError": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": [
    "portalServer.ts",
    "compilerService.ts",
    "githubPublisher.ts",
    "libraryPaths.ts",
    "libraryStore.ts",
    "liveDeployment.ts",
    "portalJobs.ts",
    "publicationStore.ts",
    "quizFiles.ts",
    "tests/*.test.ts",
    "createJuniorQuizVersions.ts",
    "createQuizFromRuleDescription.ts",
    "regenerateSingleImage.ts",
    "suggestQuestionEdit.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
