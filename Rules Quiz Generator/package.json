{
  "name": "rules-quiz-generator",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx portalServer.ts",
    "start": "node dist/portalServer.js",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "compile": "tsx compilerService.ts ./Output ./compiled",
    "build-review:legacy": "tsx buildimagereviewpage.ts ./Output ./Input",
    "serve-review:legacy": "tsx reviewServer.ts ./Output ./Input"
  },
  "dependencies": {
    "express": "^5.2.1",
    "openai": "^6.34.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
